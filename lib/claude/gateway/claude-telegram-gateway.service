# Claude Code Telegram gateway: the one process that polls the Claude Bot and
# serves every Claude Code session on this machine (lib/claude/gateway/main.ts).
# Install: systemctl --user link <this file> && systemctl --user enable --now claude-telegram-gateway
[Unit]
Description=Claude Code Telegram gateway (agent2telegram)

[Service]
ExecStart=/usr/bin/node /home/ubuntu/pi-telegram-plus-ex/dist/lib/claude/gateway/main.js
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
