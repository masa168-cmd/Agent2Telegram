{
  "$schema": "https://json.schemastore.org/package",
  "name": "agent2telegram",
  "version": "0.1.0",
  "description": "Telegram forum-topic control of online Pi sessions, with local multi-instance routing, interactive UI, files and streaming output",
  "keywords": [
    "pi-package",
    "pi-extension",
    "telegram",
    "coding-agent",
    "remote-control"
  ],
  "license": "MIT",
  "author": "jalyfeng",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "index.ts",
    "lib/**/*.ts",
    "lib/pi/restart-helper.mjs",
    "!lib/**/__tests__/",
    "CHANGELOG.md",
    "docs/compatibility.md",
    "docs/logging.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:claude": "tsc -p tsconfig.claude.json",
    "test": "vitest run",
    "check:offline": "node scripts/offline-check.mjs",
    "test:watch": "vitest",
    "changelog:draft": "node scripts/changelog-draft.mjs",
    "changelog:roll": "node scripts/changelog-version.mjs",
    "changelog:check": "node scripts/changelog-version.mjs --check",
    "prepublishOnly": "npm test && npm run typecheck && npm run changelog:check"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://pi.dev/logo-auto.svg",
    "video": ""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/masa168-cmd/pi-telegram-plus-ex"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "dependencies": {
    "marked": "^18.0.4",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "@earendil-works/pi-coding-agent": "1.4.0"
  }
}
